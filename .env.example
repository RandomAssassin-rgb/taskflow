# TaskFlow Environment Variables Configuration

# ----------------------------------------------------
# BACKEND CONFIGURATION
# Location: backend/.env
# ----------------------------------------------------
# PostgreSQL database connection string (Neon Pooled connection)
DATABASE_URL="postgresql://user:password@ep-xxx.neon.tech/taskflow?sslmode=require"

# Direct URL for Prisma migrations (Neon Direct connection)
DIRECT_URL="postgresql://user:password@ep-xxx.neon.tech/taskflow?sslmode=require&connect_timeout=15"

# Secret key used for signing JSON Web Tokens
JWT_SECRET="your-super-secret-jwt-key"

# JWT Expiration time (e.g., "1d", "7d", "1h")
JWT_EXPIRES_IN="7d"

# The origin of the web client for CORS (e.g. your Vercel URL)
CLIENT_ORIGIN="https://your-taskflow-web.vercel.app"

# Port for the Node.js Express server to run on
PORT=3000

# Environment (development or production)
NODE_ENV="development"

# ----------------------------------------------------
# MOBILE CONFIGURATION
# Location: mobile/.env
# ----------------------------------------------------
# The URL pointing to your backend API
# Use Render API URL in production
EXPO_PUBLIC_API_URL="https://your-taskflow-backend.onrender.com/api"

# ----------------------------------------------------
# WEB CONFIGURATION
# Location: web/.env
# ----------------------------------------------------
# The URL pointing to your backend API
# Use Render API URL in production
VITE_API_URL="https://your-taskflow-backend.onrender.com/api"
